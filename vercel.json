{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx expo export -p web --no-ssg",
  "outputDirectory": "dist/client",
  "regions": ["bom1"],
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/server/**",
      "maxDuration": 60
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
