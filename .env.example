# Copy to .env and fill in. Never commit .env.

# --- Server only (used by the API routes in src/app/api, never shipped in the app) ---
# Supabase Postgres: Connect > Session pooler (IPv4; the direct db.<ref>.supabase.co host is IPv6-only).
# URL-encode special characters in the password, e.g. @ -> %40. Then run `npm run db:push`.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Your Flash integrator key from https://app.definitive.fi (More > Flash > Create Flash Key).
# Leave empty to use the public development key from the Flash docs (fees then do NOT reach you).
FLASH_API_KEY=

# Optional: Solana RPC the server uses to fetch blockhashes and broadcast the one-time setup transaction.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Development over a USB cable: put REACT_NATIVE_PACKAGER_HOSTNAME=localhost in .env.local (Expo only accepts it
# there). Expo then gives the phone localhost and forwards the port with adb reverse. Leave it out to use Wi-Fi.

# --- Client (bundled into the app) ---
# Optional: your own Base RPC for reading balances / waiting on approvals.
EXPO_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
# Optional: Solana RPC the app reads SOL / USDC / wSOL balances from.
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
