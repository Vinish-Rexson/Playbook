# Copy to .env and fill in. Never commit .env.

# --- Server only (used by the API routes in src/app/api, never shipped in the app) ---
# Your Flash integrator key from https://app.definitive.fi (More > Flash > Create Flash Key).
# Leave empty to use the public development key from the Flash docs (fees then do NOT reach you).
FLASH_API_KEY=

# --- Client (bundled into the app) ---
# Optional: your own Base RPC for reading balances / waiting on approvals.
EXPO_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
